# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# FiraCode fonts - downloaded at install time, not committed
fonts/

# Inferno AoIP and its PTP clock daemon - pinned third-party checkouts built at
# install time (see DEPLOYMENT.md), not part of this app's source.
/inferno/
/statime/
# usrvclock stub built from inferno's test sources, used where the LAN has no
# PTP grandmaster (see deploy/pi9696-clock.service)
/fake_usrvclock_server

# htmax.js (htmx + bundled extensions) - downloaded at install time, not committed
web/htmax.min.js
# uPlot bundle + CSS (telemetry graphs) - downloaded at install time, not committed
web/uPlot.iife.min.js
web/uPlot.min.css

# Built binaries
/pi9696
/font-converter
/simcheck

# Editor/IDE
# .idea/
# .vscode/
# Local dev-tool config (machine-specific permissions etc.)
.claude/

# Locally built test binaries
/pi9696-test
