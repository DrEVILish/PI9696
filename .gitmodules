[submodule "third_party/ftl-themes"]
	path = third_party/ftl-themes
	url = https://github.com/DrEVILish/ftl-themes
	# Pinned to the themes PR branch ON PURPOSE: dist/ + themes.json only
	# exist there until DrEVILish/ftl-themes#2 merges. Flip to main the
	# moment it lands, then `git submodule update --remote`.
	branch = claude/theme-engine-v3
