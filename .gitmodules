[submodule "third_party/ftl-themes"]
	path = third_party/ftl-themes
	url = https://github.com/DrEVILish/ftl-themes
	# Tracks main (ftl-themes#2 merged, so dist/ lives there now). Pinned to
	# a tested commit; advance deliberately with
	# `git submodule update --remote` + full suite, never blindly.
	branch = main
