[Unit]
Description=usrvclock exporter for Inferno (PI9696)
Documentation=https://gitlab.com/lumifaza/usrvclock
Documentation=https://github.com/teodly/inferno
# Inferno needs a clock overlay on the usrvclock socket before it will
# transmit; without one it aborts with
#   "no clock available (timeout waiting for overlay update)"
# or, once connected but never updated,
#   "unable to get start timestamp for ring buffer output"
# and the inferno TX device never carries audio. The receiver still starts, so
# the fault looks like a broken inferno path rather than a missing clock.
#
# This unit runs a stub exporter for a LAN with no PTP leader. It publishes
# this host's own uptime clock, so it is single-host only, and the recording
# gate never treats it as synced: use deploy/statime.service for recording.
# Per the Inferno README, software timestamping is the default and works with
# any NIC, using the Statime fork:
#
#   git clone --recurse-submodules -b inferno-dev https://github.com/teodly/statime
#   cd statime && cargo build --release
#   # edit inferno-ptpv1.toml: set interface, leave the rest as shipped
#   ExecStart=__PI9696_DIR__/statime/target/release/statime -c inferno-ptpv1.toml
#
# Measured here: with protocol-version = PTPv2 that does become a working
# master, but with no hardware device on the network it never publishes the
# overlay, so transmit still cannot start. Replace this stub with Statime as
# soon as a hardware inferno-network device is on the LAN. The README also notes that NTP stepping
# the system clock collides with PTP.
Before=pi9696.service
Conflicts=statime.service

[Service]
Type=simple
Environment=USRVCLOCK_SOCKET=/tmp/ptp-usrvclock
ExecStart=__PI9696_DIR__/fake_usrvclock_server
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
